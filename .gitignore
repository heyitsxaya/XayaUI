# Audio is NOT tracked: sounds from other sources carry their own terms and are kept out of the repository. Add your own files locally; see Media/Audio/README.md.
Media/Audio/*
!Media/Audio/README.md
!Media/Audio/Custom/
Media/Audio/Custom/*
!Media/Audio/Custom/.gitkeep
*.ogg
*.mp3
*.wav

# editor / OS / backups
*.bak
*.orig
.DS_Store
Thumbs.db

# Extracted Blizzard UI art converted from Xaya's Iconography folder: personal use only
Media/Graphics/*
!Media/Graphics/README.md

# Claude Code handoff notes (local only)
CLAUDE-CODE-HANDOFF.md
HANDOFF-TO-CLAUDE-CODE-*.md

# QoL Elements: taken out for the time being (stat text boxes, cursor tracker + at-cursor reminders, buff bars).
# The files stay on disk but are not loaded (see XayaUI.toc) and not published. To bring them back: delete these
# lines, re-add the four files to XayaUI.toc after Visual.lua, then `git add` them.
QoL.lua
CursorTracker.lua
CursorReminders.lua
Bars.lua
Media/Cursor/*
# every cursor picture (Arrow, Fill_*, Ring*, CircleHD, HLRing_*) is part of the addon; other files in this folder (backups) stay local
!Media/Cursor/*.tga

# CC0 (public domain) sounds ARE tracked: Kenney "Interface Sounds" 1.0, see Media/Audio/CC0/CREDITS.md
!Media/Audio/CC0/
!Media/Audio/CC0/**
